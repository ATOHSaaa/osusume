---
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { MANGA_LIST_PATH } from '../../lib/constants';
import { getMangaArticles } from '../../lib/articles';
import { buildCategoryPageJsonLd } from '../../lib/structured-data';
import { getCollection } from 'astro:content';

const articles = await getCollection('articles');
const mangaArticles = getMangaArticles(articles);
const pageTitle = '漫画のおすすめ';
const pageDescription =
  'おすすめ漫画のランキング記事一覧。Web上の紹介記事での言及頻度をもとに、よく推される作品を紹介しています。';
const jsonLd = buildCategoryPageJsonLd({
  site: Astro.site,
  title: pageTitle,
  description: pageDescription,
  path: MANGA_LIST_PATH,
});
const breadcrumbs = [
  { name: 'ホーム', path: '/' },
  { name: pageTitle, path: MANGA_LIST_PATH },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  wide
  jsonLd={jsonLd}
>
  {
    mangaArticles.length === 0 ? (
      <p class="category-empty">まだ記事がありません。</p>
    ) : (
      <div class="category-page">
        <Breadcrumbs items={breadcrumbs} />
        <h1 class="category-page__heading">{pageTitle}</h1>
        <p class="category-page__lead">
          Web上のおすすめ記事で言及されやすい漫画を、テーマごとにランキングしています。
        </p>
        <ul class="article-list">
          {mangaArticles.map((article) => (
            <ArticleCard article={article} />
          ))}
        </ul>
      </div>
    )
  }
</Layout>

<style>
  .category-page__heading {
    font-size: 2rem;
    font-weight: 700;
    margin: 0 0 0.75rem;
    line-height: 1.3;
  }

  .category-page__lead {
    margin: 0 0 1.5rem;
    color: var(--color-muted);
    line-height: 1.7;
  }

  .category-empty {
    color: var(--color-muted);
    text-align: center;
    padding: 4rem 0;
    margin: 0;
  }

  .article-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  @media (min-width: 1024px) {
    .article-list {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
  }
</style>
