---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PrizePageStyles from '../../components/award/PrizePageStyles.astro';
import {
  AWARDS_HUB_PATH,
  HUB_SECTIONS,
  getAwardPath,
  getAwardsByHubSection,
} from '../../lib/awards/registry';
import { groupPrizeBySession } from '../../lib/awards/group';
import { loadPrizeData } from '../../lib/awards/data';
import { buildCategoryPageJsonLd } from '../../lib/structured-data';

const pageTitle = '文学賞・新人賞のまとめ';
const pageDescription =
  '芥川賞・直木賞・本屋大賞をはじめ、主要文学賞・ミステリー賞・新人賞の受賞作・候補作・受賞作家を一覧で紹介します。';

function getAwardStats(slug: string) {
  const data = loadPrizeData(slug);
  const sessions = groupPrizeBySession(data.entries);
  const workCount = sessions.reduce((n, s) => n + s.winners.length, 0);
  const minSession = sessions[sessions.length - 1]?.session;
  const maxSession = sessions[0]?.session;
  return { workCount, minSession, maxSession };
}

const jsonLd = buildCategoryPageJsonLd({
  site: Astro.site,
  title: pageTitle,
  description: pageDescription,
  path: AWARDS_HUB_PATH,
});
const breadcrumbs = [
  { name: 'ホーム', path: '/' },
  { name: pageTitle, path: AWARDS_HUB_PATH },
];
---

<Layout title={pageTitle} description={pageDescription} wide jsonLd={jsonLd}>
  <PrizePageStyles />
  <div class="awards-hub">
    <header>
      <Breadcrumbs items={breadcrumbs} />
      <h1 class="prize-page__heading">{pageTitle}</h1>
      <p class="prize-page__lead">
        主要な文学賞・ミステリー賞・SF賞・新人賞について、歴代受賞作・候補作・受賞作家のおすすめ記事へのリンクをまとめています。
      </p>
    </header>

    {
      HUB_SECTIONS.map((section) => {
        const awards = getAwardsByHubSection(section.id);
        if (awards.length === 0) return null;
        return (
          <section class="awards-hub__section" aria-labelledby={`${section.id}-heading`}>
            <h2 id={`${section.id}-heading`} class="awards-hub__heading">
              {section.title}
            </h2>
            <ul class="award-links">
              {
                awards.map((award) => {
                  const stats = getAwardStats(award.slug);
                  return (
                    <li>
                      <a href={getAwardPath(award.slug)} class="award-link">
                        <span class="award-link__title">{award.name}受賞作一覧</span>
                        <span class="award-link__meta">
                          {stats.minSession && stats.maxSession
                            ? `第${stats.minSession}回〜第${stats.maxSession}回 · ${stats.workCount}作品`
                            : `${stats.workCount}作品`}
                        </span>
                        <span class="award-link__desc">{award.description}</span>
                      </a>
                    </li>
                  );
                })
              }
            </ul>
          </section>
        );
      })
    }
  </div>
</Layout>
