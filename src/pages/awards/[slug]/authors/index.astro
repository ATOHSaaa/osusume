---
import Layout from '../../../../layouts/Layout.astro';
import PrizePageStyles from '../../../../components/award/PrizePageStyles.astro';
import { AWARD_BY_SLUG } from '../../../../lib/awards/registry';
import {
  getAwardNomineePath,
  getAwardPath,
} from '../../../../lib/awards/registry';
import { getUniqueAuthors } from '../../../../lib/awards/group';
import { loadPrizeData } from '../../../../lib/awards/data';
import { buildAuthorSlugByName } from '../../../../lib/article-author-slug';
import { normalizeAuthorName } from '../../../../lib/awards/normalize';
import { SITE_NAME } from '../../../../lib/constants';
import { buildCategoryPageJsonLd } from '../../../../lib/structured-data';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return [...AWARD_BY_SLUG.keys()].map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const award = AWARD_BY_SLUG.get(slug!);
if (!award) throw new Error(`Unknown award: ${slug}`);

const pageTitle = `${award.name}受賞作家一覧`;
const pageDescription = `${award.name}の歴代受賞作家を一覧化。おすすめ作品記事へのリンクも掲載しています。`;
const prizeData = loadPrizeData(award.slug);
const authors = getUniqueAuthors(prizeData.entries);

const articles = await getCollection('articles');
const authorSlugByName = buildAuthorSlugByName(articles);

const authorWorks = new Map<string, string[]>();
for (const entry of prizeData.entries) {
  const key = normalizeAuthorName(entry.author);
  const works = authorWorks.get(key) ?? [];
  if (!works.includes(entry.title)) works.push(entry.title);
  authorWorks.set(key, works);
}

const jsonLd = buildCategoryPageJsonLd({
  site: Astro.site,
  title: pageTitle,
  description: pageDescription,
  path: `/awards/${award.slug}/authors/`,
});
---

<Layout title={`${pageTitle} — ${SITE_NAME}`} description={pageDescription} wide jsonLd={jsonLd}>
  <PrizePageStyles />
  <div class="prize-page">
    <header class="prize-page__header">
      <h1 class="prize-page__heading">{pageTitle}</h1>
      <p class="prize-page__lead">
        {award.name}の歴代受賞作家 {authors.length}名を掲載しています。
        おすすめ作品記事がある作家はリンクからご覧いただけます。
      </p>
      <nav class="prize-page__nav" aria-label="関連ページ">
        <a href={getAwardPath(award.slug)}>受賞作一覧</a>
        {award.hasNominees && <a href={getAwardNomineePath(award.slug)}>候補作一覧</a>}
      </nav>
    </header>

    <ul class="author-list">
      {
        authors.map((author) => {
          const authorKey = normalizeAuthorName(author);
          const authorSlug = authorSlugByName.get(authorKey);
          const works = authorWorks.get(authorKey) ?? [];

          return (
            <li class="author-list__item">
              <div class="author-list__name">
                {authorSlug ? (
                  <a href={`/articles/${authorSlug}/`}>{author}</a>
                ) : (
                  author
                )}
              </div>
              <div class="author-list__meta">
                受賞作: {works.slice(0, 3).map((w) => `『${w}』`).join('、')}
                {works.length > 3 ? ` 他${works.length - 3}作` : ''}
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</Layout>
