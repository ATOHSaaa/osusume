---
import Layout from '../../../layouts/Layout.astro';
import PrizePageStyles from '../../../components/award/PrizePageStyles.astro';
import { AWARD_BY_SLUG } from '../../../lib/awards/registry';
import {
  getAwardAuthorsPath,
  getAwardNomineePath,
  getAwardPath,
} from '../../../lib/awards/registry';
import { groupPrizeBySession } from '../../../lib/awards/group';
import { loadPrizeData } from '../../../lib/awards/data';
import { buildAuthorSlugByName } from '../../../lib/article-author-slug';
import { normalizeAuthorName } from '../../../lib/awards/normalize';
import { SITE_NAME } from '../../../lib/constants';
import { buildCategoryPageJsonLd } from '../../../lib/structured-data';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return [...AWARD_BY_SLUG.keys()].map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const award = AWARD_BY_SLUG.get(slug!);
if (!award) throw new Error(`Unknown award: ${slug}`);

const pageTitle = `${award.name}受賞作一覧`;
const pageDescription = `${award.name}の歴代受賞作を回別に一覧化。受賞者と作品名を新しい回から掲載しています。`;
const prizeData = loadPrizeData(award.slug);
const sessions = groupPrizeBySession(prizeData.entries);

const articles = await getCollection('articles');
const authorSlugByName = buildAuthorSlugByName(articles);

const jsonLd = buildCategoryPageJsonLd({
  site: Astro.site,
  title: pageTitle,
  description: pageDescription,
  path: getAwardPath(award.slug),
});
---

<Layout title={`${pageTitle} — ${SITE_NAME}`} description={pageDescription} wide jsonLd={jsonLd}>
  <PrizePageStyles />
  <div class="prize-page">
    <header class="prize-page__header">
      <h1 class="prize-page__heading">{pageTitle}</h1>
      <p class="prize-page__lead">
        {award.prizeLead}
        第{sessions[0]?.session ?? '—'}回から第{sessions[sessions.length - 1]?.session ?? '—'}回まで掲載しています。
      </p>
      <nav class="prize-page__nav" aria-label="関連ページ">
        <a href={getAwardAuthorsPath(award.slug)}>受賞作家一覧</a>
        {award.hasNominees && <a href={getAwardNomineePath(award.slug)}>候補作一覧</a>}
      </nav>
    </header>

    <div class="prize-table-wrap">
      <table class="prize-table">
        <thead>
          <tr>
            <th scope="col">回</th>
            {!award.hidePeriodColumn && <th scope="col">対象期間</th>}
            <th scope="col">受賞者</th>
            <th scope="col">受賞作</th>
          </tr>
        </thead>
        <tbody>
          {
            sessions.map((session) =>
              session.winners.map((winner, index) => {
                const authorKey = normalizeAuthorName(winner.author);
                const authorSlug = authorSlugByName.get(authorKey);
                const authorHref = authorSlug ? `/articles/${authorSlug}/` : undefined;

                return (
                  <tr>
                    {
                      index === 0 && (
                        <>
                          <th scope="row" rowspan={session.winners.length} class="prize-table__session">
                            第{session.session}回
                          </th>
                          {
                            !award.hidePeriodColumn && (
                              <td rowspan={session.winners.length} class="prize-table__period">
                                {session.period || '—'}
                              </td>
                            )
                          }
                        </>
                      )
                    }
                    <td class="prize-table__author">
                      {winner.author ? (
                        authorHref ? <a href={authorHref}>{winner.author}</a> : winner.author
                      ) : (
                        '—'
                      )}
                    </td>
                    <td class="prize-table__title">
                      {
                        winner.amazonUrl ? (
                          <a
                            href={winner.amazonUrl}
                            rel="noopener noreferrer sponsored"
                            target="_blank"
                          >
                            『{winner.title}』
                          </a>
                        ) : (
                          <>『{winner.title}』</>
                        )
                      }
                    </td>
                  </tr>
                );
              })
            )
          }
        </tbody>
      </table>
    </div>
  </div>
</Layout>
