---
import Layout from '../../../layouts/Layout.astro';
import { AKUTAGAWA_PRIZE_PATH, SITE_NAME } from '../../../lib/constants';
import {
  groupAkutagawaPrizeBySession,
  normalizeAuthorName,
} from '../../../lib/akutagawa-prize';
import { buildCategoryPageJsonLd } from '../../../lib/structured-data';
import { getCollection } from 'astro:content';

const pageTitle = '芥川賞受賞作一覧';
const pageDescription =
  '芥川賞（芥川龍之介賞）の歴代受賞作を回別に一覧化。受賞者と作品名を新しい回から掲載しています。';
const sessions = groupAkutagawaPrizeBySession();

const articles = await getCollection('articles');
const authorSlugByName = new Map<string, string>();
for (const article of articles) {
  if (article.data.kind !== 'author') continue;
  authorSlugByName.set(normalizeAuthorName(article.data.author), article.slug);
}

const jsonLd = buildCategoryPageJsonLd({
  site: Astro.site,
  title: pageTitle,
  description: pageDescription,
  path: AKUTAGAWA_PRIZE_PATH,
});
---

<Layout
  title={`${pageTitle} — ${SITE_NAME}`}
  description={pageDescription}
  wide
  jsonLd={jsonLd}
>
  <div class="prize-page">
    <header class="prize-page__header">
      <h1 class="prize-page__heading">{pageTitle}</h1>
      <p class="prize-page__lead">
        純文学の新人・無名作家に贈られる芥川賞（通称）の受賞作を、第{sessions[0]?.session ?? '—'}回から第{sessions[sessions.length - 1]?.session ?? '—'}回まで一覧にしました。
        同一回に複数の受賞作がある場合も、そのまま掲載しています。
      </p>
    </header>

    <div class="prize-table-wrap">
      <table class="prize-table">
        <thead>
          <tr>
            <th scope="col">回</th>
            <th scope="col">対象期間</th>
            <th scope="col">受賞者</th>
            <th scope="col">受賞作</th>
          </tr>
        </thead>
        <tbody>
          {
            sessions.map((session) =>
              session.winners.map((winner, index) => {
                const authorKey = normalizeAuthorName(winner.author);
                const authorSlug = authorSlugByName.get(authorKey);
                const authorHref = authorSlug ? `/articles/${authorSlug}/` : undefined;

                return (
                  <tr>
                    {
                      index === 0 && (
                        <>
                          <th scope="row" rowspan={session.winners.length} class="prize-table__session">
                            第{session.session}回
                          </th>
                          <td rowspan={session.winners.length} class="prize-table__period">
                            {session.period}
                          </td>
                        </>
                      )
                    }
                    <td class="prize-table__author">
                      {
                        authorHref ? (
                          <a href={authorHref}>{winner.author}</a>
                        ) : (
                          winner.author
                        )
                      }
                    </td>
                    <td class="prize-table__title">
                      {
                        winner.amazonUrl ? (
                          <a
                            href={winner.amazonUrl}
                            rel="noopener noreferrer sponsored"
                            target="_blank"
                          >
                            『{winner.title}』
                          </a>
                        ) : (
                          <>『{winner.title}』</>
                        )
                      }
                    </td>
                  </tr>
                );
              })
            )
          }
        </tbody>
      </table>
    </div>
  </div>
</Layout>

<style>
  .prize-page__heading {
    font-size: 2rem;
    font-weight: 700;
    margin: 0 0 1rem;
    line-height: 1.3;
  }

  .prize-page__lead {
    margin: 0 0 2rem;
    line-height: 1.7;
  }

  .prize-table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .prize-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .prize-table th,
  .prize-table td {
    border-bottom: 1px solid var(--color-border);
    padding: 0.75rem 0.875rem;
    vertical-align: top;
    text-align: left;
  }

  .prize-table thead th {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-muted);
    border-bottom-width: 2px;
    white-space: nowrap;
  }

  .prize-table__session {
    white-space: nowrap;
    font-weight: 600;
  }

  .prize-table__period {
    white-space: nowrap;
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  .prize-table__title {
    min-width: 10rem;
  }

  .prize-table__title a {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-accent) 35%, transparent);
    text-underline-offset: 0.15em;
  }

  .prize-table__title a:hover {
    text-decoration-color: var(--color-accent);
  }

  .prize-table tbody tr:hover {
    background: color-mix(in srgb, var(--color-border) 35%, transparent);
  }

  @media (max-width: 640px) {
    .prize-page__heading {
      font-size: 1.5rem;
    }

    .prize-table {
      font-size: 0.875rem;
    }

    .prize-table th,
    .prize-table td {
      padding: 0.625rem 0.5rem;
    }
  }
</style>
