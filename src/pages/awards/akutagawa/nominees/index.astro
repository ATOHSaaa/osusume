---
import Layout from '../../../../layouts/Layout.astro';
import {
  AKUTAGAWA_NOMINEE_PATH,
  AKUTAGAWA_PRIZE_PATH,
  SITE_NAME,
} from '../../../../lib/constants';
import {
  groupAkutagawaNomineeBySession,
  normalizeAuthorName,
} from '../../../../lib/akutagawa-nominee';
import { buildCategoryPageJsonLd } from '../../../../lib/structured-data';
import { getCollection } from 'astro:content';

const pageTitle = '芥川賞候補作一覧';
const pageDescription =
  '芥川賞（芥川龍之介賞）の歴代候補作を回別に一覧化。受賞作を含む最終候補作品を新しい回から掲載しています。';
const sessions = groupAkutagawaNomineeBySession();

const articles = await getCollection('articles');
const authorSlugByName = new Map<string, string>();
for (const article of articles) {
  if (article.data.kind !== 'author') continue;
  authorSlugByName.set(normalizeAuthorName(article.data.author), article.slug);
}

const jsonLd = buildCategoryPageJsonLd({
  site: Astro.site,
  title: pageTitle,
  description: pageDescription,
  path: AKUTAGAWA_NOMINEE_PATH,
});
---

<Layout
  title={`${pageTitle} — ${SITE_NAME}`}
  description={pageDescription}
  wide
  jsonLd={jsonLd}
>
  <div class="prize-page">
    <header class="prize-page__header">
      <h1 class="prize-page__heading">{pageTitle}</h1>
      <p class="prize-page__lead">
        芥川賞の最終候補作（受賞作を含む）を、第{sessions[0]?.session ?? '—'}回から第{sessions[sessions.length - 1]?.session ?? '—'}回まで一覧にしました。
        同一回に複数作品が候補となった場合や、受賞作が複数ある場合もそのまま掲載しています。
        <a href={AKUTAGAWA_PRIZE_PATH}>受賞作一覧</a>もあわせてご覧ください。
      </p>
    </header>

    <div class="prize-table-wrap">
      <table class="prize-table">
        <thead>
          <tr>
            <th scope="col">回</th>
            <th scope="col">対象期間</th>
            <th scope="col">候補者</th>
            <th scope="col">候補作</th>
          </tr>
        </thead>
        <tbody>
          {
            sessions.map((session) =>
              session.nominees.map((nominee, index) => {
                const authorKey = normalizeAuthorName(nominee.author);
                const authorSlug = authorSlugByName.get(authorKey);
                const authorHref = authorSlug ? `/articles/${authorSlug}/` : undefined;

                return (
                  <tr class:list={{ 'prize-table__row--winner': nominee.won }}>
                    {
                      index === 0 && (
                        <>
                          <th scope="row" rowspan={session.nominees.length} class="prize-table__session">
                            第{session.session}回
                          </th>
                          <td rowspan={session.nominees.length} class="prize-table__period">
                            {session.period}
                          </td>
                        </>
                      )
                    }
                    <td class="prize-table__author">
                      {
                        authorHref ? (
                          <a href={authorHref}>{nominee.author}</a>
                        ) : (
                          nominee.author
                        )
                      }
                      {
                        nominee.won && (
                          <span class="prize-table__badge">受賞</span>
                        )
                      }
                    </td>
                    <td class="prize-table__title">
                      {
                        nominee.amazonUrl ? (
                          <a
                            href={nominee.amazonUrl}
                            rel="noopener noreferrer sponsored"
                            target="_blank"
                          >
                            『{nominee.title}』
                          </a>
                        ) : (
                          <>『{nominee.title}』</>
                        )
                      }
                    </td>
                  </tr>
                );
              })
            )
          }
        </tbody>
      </table>
    </div>
  </div>
</Layout>

<style>
  .prize-page__heading {
    font-size: 2rem;
    font-weight: 700;
    margin: 0 0 1rem;
    line-height: 1.3;
  }

  .prize-page__lead {
    margin: 0 0 2rem;
    line-height: 1.7;
  }

  .prize-page__lead a {
    color: var(--color-accent);
  }

  .prize-table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .prize-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .prize-table th,
  .prize-table td {
    border-bottom: 1px solid var(--color-border);
    padding: 0.75rem 0.875rem;
    vertical-align: top;
    text-align: left;
  }

  .prize-table thead th {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-muted);
    border-bottom-width: 2px;
    white-space: nowrap;
  }

  .prize-table__session {
    white-space: nowrap;
    font-weight: 600;
  }

  .prize-table__period {
    white-space: nowrap;
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  .prize-table__title {
    min-width: 10rem;
  }

  .prize-table__title a {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-accent) 35%, transparent);
    text-underline-offset: 0.15em;
  }

  .prize-table__title a:hover {
    text-decoration-color: var(--color-accent);
  }

  .prize-table__badge {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.125rem 0.375rem;
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1.4;
    color: var(--color-accent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 45%, transparent);
    border-radius: 0.25rem;
    vertical-align: middle;
    white-space: nowrap;
  }

  .prize-table__row--winner {
    background: color-mix(in srgb, var(--color-accent) 6%, transparent);
  }

  .prize-table tbody tr:hover {
    background: color-mix(in srgb, var(--color-border) 35%, transparent);
  }

  .prize-table__row--winner:hover {
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
  }

  @media (max-width: 640px) {
    .prize-page__heading {
      font-size: 1.5rem;
    }

    .prize-table {
      font-size: 0.875rem;
    }

    .prize-table th,
    .prize-table td {
      padding: 0.625rem 0.5rem;
    }
  }
</style>
