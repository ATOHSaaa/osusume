---
import CategoryMoreLink from './CategoryMoreLink.astro';
import {
  ARTICLE_LIST_LIMIT,
  AUTHOR_LIST_PATH,
  GENRE_LIST_PATH,
} from '../lib/constants';
import { sortArticlesByAuthor } from '../lib/articles';
import { pickSidebarAuthorArticles } from '../lib/gsc-top-authors';
import type { CollectionEntry } from 'astro:content';

interface Props {
  authorArticles: CollectionEntry<'articles'>[];
  genreArticles: CollectionEntry<'articles'>[];
  currentSlug?: string;
}

const { authorArticles, genreArticles, currentSlug } = Astro.props;

const sidebarAuthorItems = pickSidebarAuthorArticles(authorArticles, ARTICLE_LIST_LIMIT);
const sortedGenreArticles = [...genreArticles].sort(sortArticlesByAuthor);

function rankClass(rank: number): string {
  if (rank === 1) return 'article-nav-sidebar__rank--gold';
  if (rank === 2) return 'article-nav-sidebar__rank--silver';
  if (rank === 3) return 'article-nav-sidebar__rank--bronze';
  return 'article-nav-sidebar__rank--default';
}
---

<aside class="article-nav-sidebar">
  <nav aria-label="記事一覧">
    {
      sidebarAuthorItems.length > 0 && (
        <div class="article-nav-sidebar__group">
          <h2 class="article-nav-sidebar__heading">アクセス数の多い作家</h2>
          <ul class="article-nav-sidebar__list">
            {sidebarAuthorItems.map(({ article, rank }) => (
              <li>
                <a
                  href={`/articles/${article.slug}/`}
                  class="article-nav-sidebar__link"
                  aria-current={article.slug === currentSlug ? 'page' : undefined}
                >
                  <span class:list={['article-nav-sidebar__rank', rankClass(rank)]}>
                    {rank}
                  </span>
                  <span class="article-nav-sidebar__label">{article.data.author}</span>
                </a>
              </li>
            ))}
          </ul>
          {
            authorArticles.length > ARTICLE_LIST_LIMIT && (
              <CategoryMoreLink href={AUTHOR_LIST_PATH} class="sidebar-more" />
            )
          }
        </div>
      )
    }
    {
      sortedGenreArticles.length > 0 && (
        <div class="article-nav-sidebar__group">
          <h2 class="article-nav-sidebar__heading">ジャンル別のおすすめ</h2>
          <ul
            class="article-nav-sidebar__list"
            data-random-list
            data-random-limit={ARTICLE_LIST_LIMIT}
          >
            {sortedGenreArticles.map((article) => (
              <li>
                <a
                  href={`/articles/${article.slug}/`}
                  class="article-nav-sidebar__link article-nav-sidebar__link--plain"
                  aria-current={article.slug === currentSlug ? 'page' : undefined}
                >
                  {article.data.author}
                </a>
              </li>
            ))}
          </ul>
          {
            sortedGenreArticles.length > ARTICLE_LIST_LIMIT && (
              <CategoryMoreLink href={GENRE_LIST_PATH} class="sidebar-more" />
            )
          }
        </div>
      )
    }
  </nav>
</aside>

<style is:global>
  .article-nav-sidebar__group + .article-nav-sidebar__group {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .article-nav-sidebar__heading {
    font-size: 1rem;
    font-weight: 800;
    color: var(--color-text);
    letter-spacing: var(--heading-letter-spacing);
    margin: 0 0 0.75rem;
    line-height: 1.3;
  }

  .article-nav-sidebar__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .article-nav-sidebar__link {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.375rem 0.625rem;
    margin: 0 -0.625rem;
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.45;
    color: var(--color-text);
    text-decoration: none;
  }

  .article-nav-sidebar__link:hover {
    background: rgba(0, 0, 0, 0.04);
  }

  .article-nav-sidebar__link[aria-current='page'] {
    background: rgba(194, 65, 12, 0.08);
    color: var(--color-accent);
    font-weight: 700;
  }

  .article-nav-sidebar__rank {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 800;
    line-height: 1;
  }

  .article-nav-sidebar__rank--gold {
    background: linear-gradient(145deg, #f5d061, #d4a017);
    color: #4a3200;
  }

  .article-nav-sidebar__rank--silver {
    background: linear-gradient(145deg, #e8edf2, #a8b0ba);
    color: #2f3640;
  }

  .article-nav-sidebar__rank--bronze {
    background: linear-gradient(145deg, #e0a56a, #a8642f);
    color: #3f2208;
  }

  .article-nav-sidebar__rank--default {
    background: #1a1a1a;
    color: #ffffff;
  }

  .article-nav-sidebar__label {
    min-width: 0;
  }

  .article-nav-sidebar__group .sidebar-more {
    margin-top: 0.75rem;
    padding: 0.5rem 0.625rem;
    font-size: 0.8125rem;
  }
</style>
