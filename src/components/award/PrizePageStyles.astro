---
// 文学賞ページ共通スタイル
---

<style is:global>
  .prize-page__heading {
    font-size: 2rem;
    font-weight: 700;
    margin: 0 0 1rem;
    line-height: 1.3;
  }

  .prize-page__lead {
    margin: 0 0 1.5rem;
    line-height: 1.7;
  }

  .prize-page__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin: 0 0 2rem;
    font-size: 0.9375rem;
  }

  .prize-page__nav a {
    color: var(--color-accent);
  }

  .prize-table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .prize-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .prize-table th,
  .prize-table td {
    border-bottom: 1px solid var(--color-border);
    padding: 0.75rem 0.875rem;
    vertical-align: top;
    text-align: left;
  }

  .prize-table thead th {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-muted);
    border-bottom-width: 2px;
    white-space: nowrap;
  }

  .prize-table__session {
    white-space: nowrap;
    font-weight: 600;
  }

  .prize-table__period {
    white-space: nowrap;
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  .prize-table__title {
    min-width: 10rem;
  }

  .prize-table__session a {
    color: inherit;
    text-decoration: none;
    font-weight: inherit;
  }

  .prize-table__session a:hover {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .prize-table__title a,
  .prize-table__author a,
  .author-list__name a {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-accent) 35%, transparent);
    text-underline-offset: 0.15em;
  }

  .prize-table__title a:hover,
  .prize-table__author a:hover,
  .author-list__name a:hover {
    text-decoration-color: var(--color-accent);
  }

  .prize-table__badge {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.125rem 0.375rem;
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1.4;
    color: var(--color-accent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 45%, transparent);
    border-radius: 0.25rem;
    vertical-align: middle;
    white-space: nowrap;
  }

  .prize-table__row--winner {
    background: color-mix(in srgb, var(--color-accent) 6%, transparent);
  }

  .prize-table tbody tr:hover {
    background: color-mix(in srgb, var(--color-border) 35%, transparent);
  }

  .prize-table__row--winner:hover {
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
  }

  .author-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem 1.5rem;
  }

  @media (min-width: 768px) {
    .author-list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .author-list__item {
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .author-list__name {
    font-weight: 600;
  }

  .author-list__meta {
    font-size: 0.8125rem;
    color: var(--color-muted);
    margin-top: 0.25rem;
  }

  .awards-hub__section + .awards-hub__section {
    margin-top: 3rem;
    padding-top: 3rem;
    border-top: 1px solid var(--color-border);
  }

  .awards-hub__heading {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 1.25rem;
  }

  .award-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .award-links {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }
  }

  @media (min-width: 1024px) {
    .award-links {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .award-link {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    height: 100%;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-surface);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s, background-color 0.15s;
  }

  .award-link:hover {
    border-color: var(--color-accent);
    background: rgba(194, 65, 12, 0.04);
  }

  .award-link__title {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-accent);
  }

  .award-link__meta {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-muted);
  }

  .award-link__desc {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-muted);
  }

  @media (max-width: 640px) {
    .prize-page__heading {
      font-size: 1.5rem;
    }

    .prize-table {
      font-size: 0.875rem;
    }

    .prize-table th,
    .prize-table td {
      padding: 0.625rem 0.5rem;
    }

    .author-list {
      grid-template-columns: 1fr;
    }
  }
</style>
